# Where the multiplayer server can be reached.
#
# Leave unset for browser development: the client then talks to
# ws://<current-host>:8787/ws, which is what `npm run dev:server` starts.
#
# REQUIRED for the desktop and mobile builds. They are served from
# tauri://localhost and have no HTTP origin to infer a server from.
VITE_SERVER_URL=https://dooz.example.com

# Base address used to build invite links and absolute social-preview image URLs.
#
# Also mainly for the desktop and mobile builds: a link to tauri://localhost is
# useless to the friend receiving it, so point this at the deployed web app.
VITE_PUBLIC_URL=https://dooz.example.com

# The desktop and mobile builds add VITE_SERVER_URL to the webview's content
# security policy themselves: `npm run build:desktop` (and the other
# dev:/build: Tauri scripts) go through scripts/tauri.mjs, which writes it into
# `connect-src`. Run `npm run tauri:config` to see what a build will use.

# Desktop self-updates (optional; off when either is unset). The endpoint is
# the `latest.json` the Desktop workflow attaches to each release; the key is
# the public half printed by `npx tauri signer generate`. Release builds also
# need TAURI_SIGNING_PRIVATE_KEY (a CI secret, never a file in the repo).
# TAURI_UPDATER_ENDPOINTS=https://github.com/<owner>/<repo>/releases/latest/download/latest.json
# TAURI_UPDATER_PUBKEY=

# Android App Links / iOS Universal Links for invite links (optional). Set to
# the host of VITE_PUBLIC_URL once it serves the verification files described
# in the README; without it, only dooz:// links open the app.
# TAURI_APP_LINK_HOST=dooz.example.com
