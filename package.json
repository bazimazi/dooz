{
  "name": "dooz",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "dooz (Tic Tac Toe) - cross-platform: web, desktop and mobile",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --open",
    "dev:server": "tsx watch server/main.ts",
    "start:server": "tsx server/main.ts",
    "dev:all": "npm-run-all --parallel dev:server dev",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "dev:android": "tauri android dev",
    "dev:ios": "tauri ios dev",
    "init:android": "tauri android init && npm run icons",
    "init:ios": "tauri ios init && npm run icons",
    "icons:web": "node scripts/generate-icons.mjs",
    "icons": "npm run icons:web && tauri icon assets/brand/tauri-icon.json --output src-tauri/icons/dooz && node scripts/finish-native-icons.mjs",
    "build": "npm run typecheck && vite build",
    "build:web": "npm run build",
    "build:desktop": "tauri build",
    "build:android": "tauri android build",
    "build:ios": "tauri ios build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "prettier --write .",
    "lint:fix": "oxlint --type-aware --fix",
    "bench": "tsx scripts/bench/ladder.ts",
    "bench:speed": "tsx scripts/bench/speed.ts",
    "puzzles": "tsx scripts/bench/puzzles.ts",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "audit:animations": "node scripts/animation-audit.mjs",
    "audit:experience": "node scripts/player-experience-audit.mjs",
    "audit:offline": "node scripts/offline-audit.mjs",
    "audit:home-music": "node scripts/home-music-audit.mjs",
    "audit:sheet-back": "node scripts/sheet-back-audit.mjs",
    "audit:navigation": "node scripts/navigation-audit.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^28.0.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource/joti-one": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-router": "^1.170.32",
    "@tauri-apps/api": "^2.11.1",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
