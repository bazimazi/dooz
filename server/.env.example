# Port to listen on.
PORT=8787

# Interface to bind. 0.0.0.0 accepts connections from other machines, which is
# what you want in a container; 127.0.0.1 keeps it local.
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the HTTP endpoints, or `*`.
# Set this to your deployed web origin in production.
ALLOWED_ORIGINS=*

# Where the SQLite database lives. Created on first run, along with its folder.
DATA_FILE=./data/dooz.sqlite

# Accounts one address may create per hour. Raise it behind a shared NAT or a
# proxy, where every player appears to come from the same address.
SIGNUPS_PER_HOUR=20

# Set to 1 only when a reverse proxy in front of the server sets
# X-Forwarded-For; the last entry in it is then taken as the client's address.
# Left unset, the socket's own address is used, because without a proxy the
# header is whatever the client chose to send.
TRUST_PROXY=0

# `json` (the default) or `pretty` for a readable line per event in development.
LOG_FORMAT=json
# debug | info | warn | error
LOG_LEVEL=info

# --- Web Push -----------------------------------------------------------------
# Notifications for "your move" in games by mail, friends' challenges and
# tournaments. Generate the pair once with `node scripts/generate-vapid-keys.mjs`
# and keep it: replacing it silently stops every existing subscription. Leave
# both unset to turn push off (the in-app notices still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the browsers' push services can reach you at.
VAPID_SUBJECT=mailto:you@example.com
# Push services the server will send to, comma-separated (`*.` = any subdomain).
# Push endpoints come from clients, so this list is what stops them being used
# to make the server call arbitrary URLs. The default covers Chrome, Firefox,
# Edge and Safari.
# PUSH_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,*.push.services.mozilla.com,*.notify.windows.com,web.push.apple.com,*.push.apple.com

# --- Moderation -----------------------------------------------------------------
# Bearer token for the /admin API (reports, mutes, bans, renames, anti-cheat
# flags, telemetry, backups). At least 24 characters; the admin API does not
# exist while this is unset. Generate one with `openssl rand -base64 32`.
# ADMIN_TOKEN=

# --- Backups --------------------------------------------------------------------
# Online SQLite backups (consistent while the server runs). `off` disables them.
# Defaults to a `backups` folder next to DATA_FILE.
# BACKUP_DIR=./data/backups
BACKUP_INTERVAL_HOURS=6
# How many backups to keep; older ones are deleted.
BACKUP_KEEP=14

# --- Telemetry ------------------------------------------------------------------
# Days to keep raw anonymous telemetry events. Daily counts are kept regardless.
TELEMETRY_RETENTION_DAYS=30
