{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dooz",
  "version": "1.0.0",
  "identifier": "dev.msynk.dooz",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../web"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../web"
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "dooz",
        "label": "main",
        "width": 460,
        "height": 880,
        "minWidth": 340,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#232599"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": false
      },
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:8787 ws://127.0.0.1:8787 wss://* https://*"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Tic Tac Toe on 3x3, 6x6 and 9x9 boards",
    "longDescription": "dooz is Tic Tac Toe with room to breathe: play a friend on one device or online, or take on a bot that is unbeatable at 3x3 and dangerous at 6x6 and 9x9.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
