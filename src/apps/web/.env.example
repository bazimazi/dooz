# Where the multiplayer server can be reached.
#
# Leave unset for browser development: the client then talks to
# ws://<current-host>:8787/ws, which is what `npm run dev:server` starts.
#
# REQUIRED for the desktop and mobile builds. They are served from
# tauri://localhost and have no HTTP origin to infer a server from.
VITE_SERVER_URL=https://dooz.example.com

# Base address used to build invite links.
#
# Also mainly for the desktop and mobile builds: a link to tauri://localhost is
# useless to the friend receiving it, so point this at the deployed web app.
VITE_PUBLIC_URL=https://dooz.example.com
