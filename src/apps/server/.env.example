# Port to listen on.
PORT=8787

# Interface to bind. 0.0.0.0 accepts connections from other machines, which is
# what you want in a container; 127.0.0.1 keeps it local.
HOST=0.0.0.0

# Comma-separated list of origins allowed to call the HTTP endpoints, or `*`.
# Set this to your deployed web origin in production.
ALLOWED_ORIGINS=*
